# Default pipeline needs no API key and makes no network calls.
DAYONE_LLM_ENABLED=0
DAYONE_LLM_BASE_URL=https://api.openai.com/v1
DAYONE_LLM_API_KEY=
DAYONE_LLM_MODEL=
# Optional local cached sentence-transformers model; never automatically downloaded.
DAYONE_SEMANTIC_MODEL_PATH=
# Optional USD / million tokens for a configured live provider; leave unset if unknown.
DAYONE_INPUT_COST_PER_MILLION=
DAYONE_OUTPUT_COST_PER_MILLION=
